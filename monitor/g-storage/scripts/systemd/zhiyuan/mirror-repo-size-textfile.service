[Unit]
Description=Collect mirror-zhiyuan per-repository size metrics

[Service]
Type=oneshot
ExecStart=/usr/local/bin/mirror-repo-size-collector --site zhiyuan
TimeoutStartSec=24h
Nice=19
IOSchedulingClass=idle
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/mnt/data12T
ReadWritePaths=/var/lib/node_exporter/textfile_collector /run/lock
