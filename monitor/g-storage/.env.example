GRAFANA_VERSION=11.4.0
GRAFANA_CLICKHOUSE_DATASOURCE_VERSION=4.14.0

GITHUB_CLIENT_ID=github_client_id
GITHUB_CLIENT_SECRET=github_client_secret

MIRROR_MONITOR_TEXTFILE_DIR=/var/lib/mirror-monitor/textfile_collector

# Hotspot paths and tunnel transport are committed in Compose/Vector configs.
# Only these three values belong in g-storage.sops.env.
HOTSPOT_CLICKHOUSE_INGEST_PASSWORD=hotspot_ingest_password
HOTSPOT_CLICKHOUSE_GRAFANA_PASSWORD=hotspot_grafana_password
HOTSPOT_CLIENT_HASH_KEY=hotspot_client_hash_key

MONITOR_USERNAME=monitor_username
MONITOR_PASSWORD=monitor_password

TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_CHAT_ID=0
TELEGRAM_MESSAGE_THREAD_ID=
TELEGRAM_PROXY_URL=http://metacubexd:1081
