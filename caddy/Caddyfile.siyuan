{
	key_type rsa4096
	email sjtug-mirror-maintainers@googlegroups.com
	cert_issuer acme
	metrics {
		per_host
	}
	servers {
		timeouts {
			read_body 10s
			read_header 5s
			write 600s
			idle 10m
		}
	}
	cerberus {
		difficulty 14
		max_pending 16
		access_per_approval 8
		block_ttl 12h
		pending_ttl 10m
		approval_ttl 12h
		max_mem_usage 4GiB
		cookie_name cerberus-clearance
		header_name Cerberus-Sec
		mail sjtug-mirror-maintainers@googlegroups.com
		prefix_cfg 32 64
	}
	order cerberus before redir
	order bandwidth_quota before cerberus
	order waf before bandwidth_quota
}

http://mirror.sjtu.edu.cn {
	waf {
		rule_file {$CADDY_WAF_DIR:caddy/waf}/general-policy.json
		rule_file {$CADDY_WAF_DIR:caddy/waf}/crawler-policy.json
		ip_blacklist_file {$CADDY_WAF_IP_BLACKLIST_FILE:caddy/waf/blacklist/crawler-ip-blacklist.txt}
		ip_whitelist_file {$CADDY_WAF_IP_WHITELIST_FILE:caddy/waf/blacklist/bandwidth-quota-whitelist.txt}
		dns_blacklist_file {$CADDY_WAF_DNS_BLACKLIST_FILE:caddy/waf/blacklist/dns-blacklist.txt}
		anomaly_threshold 10
		max_request_body_size 1048576
		log_severity info
		log_json
		log_path {$CADDY_WAF_LOG_PATH:/var/log/caddy/mirrorz/waf.log}
		redact_sensitive_data
	}

	@bandwidth_quota_download {
		method GET
		path /docker-ce/* /alpine/* /debian-security/* /fedora-secondary/* /openwrt/* /rpmfusion/* /debian/* /ubuntu-ports/*
	}
	bandwidth_quota @bandwidth_quota_download {
		state_path {$CADDY_BANDWIDTH_QUOTA_DB:/data/bandwidth-quota.db}
		whitelist_file {$CADDY_BANDWIDTH_QUOTA_WHITELIST_FILE:caddy/waf/blacklist/bandwidth-quota-whitelist.txt}
		ipv4_prefix 24
		ipv6_prefix 64
		window 5h 30GiB
		window 168h 150GiB
		window 720h 500GiB
	}

	log {
		output file {$CADDY_LOG_PATH:/tmp/caddy/mirrorz/access.log} {
			mode 0644
		}
		format json {
			time_key timestamp
			time_format unix_seconds_float
			duration_format seconds
		}
	}
	log_append serverip {http.request.local.host}
	log_append server_port {http.request.local.port}
	log_append scheme {http.request.scheme}
	log_append uri {http.request.uri.path}
	log_append http_host {http.request.host}
	log_append request_id {http.request.uuid}
	log_append upstream_addr {http.reverse_proxy.upstream.hostport}
	log_append upstream_header_time_ms {http.reverse_proxy.upstream.latency_ms}
	log_append upstream_response_time_ms {http.reverse_proxy.upstream.duration_ms}

	handle {
		redir https://{hostport}{uri} 308 # redirect remaining http requests to https
	}

	header * x-sjtug-mirror-id siyuan

	handle_path /.cerberus/* {
		cerberus_endpoint
	}
	@cerberus {
		not path /qt /qt/*
		path_regexp \.(?:iso|exe|dmg|run|zip|tar|tgz|txz|raw|img|ova|vhd|grd|qcow2|7z)(?:\.gz|\.xz)?$
		header User-Agent *Mozilla*
		header User-Agent *Opera*
		header User-Agent *Go-http-client*
		header User-Agent *web*spider*
		not remote_ip 10.0.0.0/8
	}
	@except_cerberus_endpoint {
		not path /.cerberus/*
		not path /qt /qt/*
		not {
			path_regexp \.(?:iso|exe|dmg|run|zip|tar|tgz|txz|raw|img|ova|vhd|grd|qcow2|7z)(?:\.gz|\.xz)?$
			header User-Agent *Mozilla*
			header User-Agent *Opera*
			header User-Agent *Go-http-client*
			header User-Agent *web*spider*
			not remote_ip 10.0.0.0/8
		}
	}
	cerberus @except_cerberus_endpoint {
		base_url /.cerberus
		block_only
	}
	cerberus @cerberus {
		base_url /.cerberus
	}

	@gzip_enabled {
		not path /docker-ce/*
		not path /deepin/*
		not path /fedora/*
		not path /fedora/epel/*
		not path /fedora/linux/*
		not path /openeuler/*
		not path /opensuse/*
		not path /remi/*
		not path /ubuntu/*
	}
	encode @gzip_enabled gzip zstd

	redir /docker-ce /docker-ce/ 301
	handle /docker-ce/* {
		reverse_proxy rsync-gateway:8000
	}
	redir /alpine /alpine/ 301
	handle /alpine/* {
		file_server browse {
			root /srv/data55T
			hide .*
		}
		@hidden path */.*
		respond @hidden 404
	}
	redir /debian-security /debian-security/ 301
	handle /debian-security/* {
		file_server browse {
			root /srv/data55T
			hide .*
		}
		@hidden path */.*
		respond @hidden 404
	}
	redir /fedora-secondary /fedora-secondary/ 301
	handle /fedora-secondary/* {
		file_server browse {
			root /srv/data55T
			hide .*
		}
		@hidden path */.*
		respond @hidden 404
	}
	redir /openwrt /openwrt/ 301
	handle /openwrt/* {
		file_server browse {
			root /srv/data55T
			hide .*
		}
		@hidden path */.*
		respond @hidden 404
	}
	redir /rpmfusion /rpmfusion/ 301
	handle /rpmfusion/* {
		file_server browse {
			root /srv/data55T
			hide .*
		}
		@hidden path */.*
		respond @hidden 404
	}
	redir /debian /debian/ 301
	handle /debian/* {
		file_server browse {
			root /srv/data55T
			hide .*
		}
		@hidden path */.*
		respond @hidden 404
	}
	redir /ubuntu-ports /ubuntu-ports/ 301
	handle /ubuntu-ports/* {
		file_server browse {
			root /srv/data55T
			hide .*
		}
		@hidden path */.*
		respond @hidden 404
	}
	redir /deepin /deepin/ 301
	handle_path /deepin/* {
		redir * {scheme}://ftp.sjtu.edu.cn/deepin{uri} 302
	}
	redir /fedora /fedora/ 301
	handle_path /fedora/* {
		redir * {scheme}://ftp.sjtu.edu.cn/fedora{uri} 302
	}
	redir /fedora/epel /fedora/epel/ 301
	handle_path /fedora/epel/* {
		redir * {scheme}://ftp.sjtu.edu.cn/fedora/epel{uri} 302
	}
	redir /fedora/linux /fedora/linux/ 301
	handle_path /fedora/linux/* {
		redir * {scheme}://ftp.sjtu.edu.cn/fedora/linux{uri} 302
	}
	redir /openeuler /openeuler/ 301
	handle_path /openeuler/* {
		redir * https://mirrors.cernet.edu.cn/openeuler{uri} 302
	}
	redir /opensuse /opensuse/ 301
	handle_path /opensuse/* {
		redir * {scheme}://ftp.sjtu.edu.cn/opensuse{uri} 302
	}
	redir /remi /remi/ 301
	handle_path /remi/* {
		redir * {scheme}://ftp.sjtu.edu.cn/remi{uri} 302
	}
	redir /ubuntu /ubuntu/ 301
	handle_path /ubuntu/* {
		redir * {scheme}://ftp.sjtu.edu.cn/ubuntu/{uri} 302
	}
}

https://mirror.sjtu.edu.cn {
	waf {
		rule_file {$CADDY_WAF_DIR:caddy/waf}/general-policy.json
		rule_file {$CADDY_WAF_DIR:caddy/waf}/crawler-policy.json
		ip_blacklist_file {$CADDY_WAF_IP_BLACKLIST_FILE:caddy/waf/blacklist/crawler-ip-blacklist.txt}
