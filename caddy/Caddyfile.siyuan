		dns_blacklist_file {$CADDY_WAF_DNS_BLACKLIST_FILE:caddy/waf/blacklist/dns-blacklist.txt}
		anomaly_threshold 10
		max_request_body_size 1048576
		log_severity info
		log_json
		log_path {$CADDY_WAF_LOG_PATH:/var/log/caddy/mirrorz/waf.log}
		redact_sensitive_data
	}

	@bandwidth_quota_download {
		method GET
		path /alhp/* /bioconductor/* /bmclapi/* /debian-cdimage/* /docker-ce/* /endeavouros/* /keyarchos/* /leopardsh/* /mx-packages/* /opencloudos/* /openkylin/* /openkylin-cdimage/* /packman/* /racket/* /raspberry-pi-os-images/* /ubuntu-cloud-images/* /alpine/* /anthon/* /apache/* /archlinuxarm/* /armbian/* /blackarch/* /debian-ports/* /debian-security/* /fedora-secondary/* /manjaro/* /OpenBSD/* /openwrt/* /qt/* /raspbian-addons/* /rocky/* /ros/* /rpmfusion/* /sury/* /termux/* /ubuntu-releases/* /zorinos-isos/* /anaconda/* /astral-wheels/* /crates.io/* /dart-pub/* /elan/* /flutter_infra/* /ghcup/* /gimp/* /gradle/distributions/* /homebrew-bottles/* /kernel/* /macports/* /pypi-packages/* /pytorch-wheels/* /rust-static/* /voidlinux/* /wireshark/* /git/doom-emacs.git/* /git/dpdk.git/* /git/flake-parts.git/* /git/flutter-sdk.git/* /git/guix.git/* /git/homebrew-bundle.git/* /git/homebrew-install.git/* /git/homebrew-services.git/* /git/lean4-packages/aesop/* /git/lean4-packages/batteries/* /git/lean4-packages/doc-gen4/* /git/lean4-packages/import-graph/* /git/lean4-packages/lean4-cli/* /git/lean4-packages/mathematics_in_lean/* /git/lean4-packages/mathematics_in_lean_source/* /git/lean4-packages/mathlib4/* /git/lean4-packages/ProofWidgets4/* /git/lean4-packages/quote4/* /git/lean4-packages/std4/* /git/linux.git/* /git/llvm-project.git/* /git/modern-sjtu-thesis.git/* /git/ohmyzsh.git/* /git/SJTUBeamer.git/* /git/SJTUTeX.git/* /git/SJTUThesis.git/* /git/spacemacs.git/* /git/spdk.git/* /git/touying-sjtu.git/* /archlinux-cn/* /debian/* /pop-os/* /test/* /ubuntu-ports/* /fedora-iot/* /fedora-ostree/* /flathub/* /github-release/* /guix/* /guix-bordeaux/* /nix-channels/store/* /opam-cache/* /pypi/web/simple/* /sjtug-internal/* /dragonflybsd/*
	}
	bandwidth_quota @bandwidth_quota_download {
		state_path {$CADDY_BANDWIDTH_QUOTA_DB:/data/bandwidth-quota.db}
		whitelist_file {$CADDY_BANDWIDTH_QUOTA_WHITELIST_FILE:caddy/waf/blacklist/bandwidth-quota-whitelist.txt}
		ipv4_prefix 24
		ipv6_prefix 64
		window 5h 30GiB
		window 168h 150GiB
		window 720h 500GiB
	}

	log {
		output file {$CADDY_LOG_PATH:/tmp/caddy/mirrorz/access.log} {
			mode 0644
		}
		format json {
			time_key timestamp
			time_format unix_seconds_float
			duration_format seconds
		}
	}
	log_append serverip {http.request.local.host}
	log_append server_port {http.request.local.port}
	log_append scheme {http.request.scheme}
	log_append uri {http.request.uri.path}
	log_append http_host {http.request.host}
	log_append request_id {http.request.uuid}
	log_append upstream_addr {http.reverse_proxy.upstream.hostport}
	log_append upstream_header_time_ms {http.reverse_proxy.upstream.latency_ms}
	log_append upstream_response_time_ms {http.reverse_proxy.upstream.duration_ms}

	handle {
		reverse_proxy /* frontend:3000
	}

	handle /mirrorz/* {
		uri strip_prefix /mirrorz
		file_server {
			root /var/www/mirrorz
		}
	}

	handle /lug/* {
		reverse_proxy /lug/* lug:7001 {
			header_down Access-Control-Allow-Origin *
			header_down Access-Control-Request-Method GET
		}
		@reject_lug_api {
			path /lug/v1/admin/*
		}
		respond @reject_lug_api 403
	}

	handle /monitor/* {
		basic_auth /monitor/* {
			{$MONITOR_USER} {$MONITOR_PASSWORD_HASHED}
		}
		handle_path /monitor/node_exporter/* {
			reverse_proxy 172.31.0.1:9100
		}
		handle_path /monitor/cadvisor/* {
			reverse_proxy cadvisor:8080
		}
		handle_path /monitor/lug/* {
			reverse_proxy lug:8081
		}
		handle_path /monitor/mirror-intel/* {
			reverse_proxy mirror-intel:8000
		}
		handle_path /monitor/vector/* {
			reverse_proxy vector:9598
		}
		handle_path /monitor/rsync-gateway/* {
			reverse_proxy rsync-gateway:8000
		}
		handle /monitor/caddy/metrics {
			rewrite * /metrics
			reverse_proxy 127.0.0.1:2019 {
				header_up Host localhost:2019
			}
		}
		handle_path /monitor/docker-gcr/* {
			reverse_proxy siyuan-gcr-registry:5001
		}
		handle_path /monitor/docker-registry/* {
			reverse_proxy siyuan-docker-registry:5001
		}
	}

	handle /.well-known/* {
		uri strip_prefix /.well-known
		file_server {
			root /var/www/.well-known
		}
	}

	header * x-sjtug-mirror-id siyuan
	header /mirrorz/* Access-Control-Allow-Origin *
	header /mirrorz/* Access-Control-Request-Method GET

	handle_path /.cerberus/* {
		cerberus_endpoint
	}
	@cerberus {
		not path /qt /qt/*
		path_regexp \.(?:iso|exe|dmg|run|zip|tar|tgz|txz|raw|img|ova|vhd|grd|qcow2|7z)(?:\.gz|\.xz)?$
		header User-Agent *Mozilla*
		header User-Agent *Opera*
		header User-Agent *Go-http-client*
		header User-Agent *web*spider*
		not remote_ip 10.0.0.0/8
